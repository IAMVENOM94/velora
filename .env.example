POSTGRES_DB=velora
POSTGRES_USER=velora
POSTGRES_PASSWORD=change-me-velora-db-password
DATABASE_URL=postgres://velora:change-me-velora-db-password@localhost:5432/velora
MINIO_ROOT_USER=velora-development
MINIO_ROOT_PASSWORD=change-me-velora-minio-password
MINIO_ACCESS_KEY=velora-development
MINIO_SECRET_KEY=change-me-velora-minio-password
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_BUCKET=velora-photos
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters
OTP_SECRET=change-me-otp-pepper-at-least-32-characters
OAUTH_STATE_SECRET=change-me-oauth-state-secret-at-least-32-characters
DEV_PROVIDER_SECRET=change-me-development-provider-test-secret
ACCESS_TTL=15m
REFRESH_TTL_DAYS=30
CORS_ORIGINS=http://localhost:8080
PORT=8080
DEMO_EMAIL=demo@velora.app
DEMO_PASSWORD=change-me-development-demo-password
# Public/provider-console configuration. Leave empty to disable the provider UI.
GOOGLE_CLIENT_ID=
# Android uses the same web client ID; pass this value to Gradle or export it before building.
GOOGLE_WEB_CLIENT_ID=
X_CLIENT_ID=
X_REDIRECT_URI=velora://auth/x
VK_CLIENT_ID=
VK_CLIENT_SECRET=
# Mobile key required only by the official VK ID Android SDK. Never reuse VK_CLIENT_SECRET here.
VK_ANDROID_CLIENT_SECRET=
VK_REDIRECT_URI=velora://auth/vk
SMS_PROVIDER_CONFIGURED=false
